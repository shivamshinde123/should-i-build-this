      "publicReportBaseUrl": "https://should-i-build-this.vercel.app",
      "router": {},
      "eas": {
        "projectId": "7426fb94-434a-4f99-b733-ad191d0f2756"
      }
    },
    "owner": "shivamshinde1234"
  }
